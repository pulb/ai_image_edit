{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pulb/ai_image_edit/blob/main/src/ai_image_edit/data/workflow.schema.json",
  "title": "AI Image Edit workflow file",
  "description": "A ComfyUI workflow (API format) plus the manifest that maps the app's inputs onto it. Described in doc/contribution/workflow_files.md.",
  "type": "object",
  "required": ["format_version", "manifest", "workflow"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "manifest": {"$ref": "#/$defs/manifest"},
    "workflow": {"$ref": "#/$defs/workflow"}
  },
  "$defs": {
    "target": {
      "description": "A workflow input: '<node id>.<input name>'. The input name may contain dots.",
      "type": "string",
      "pattern": "^[^.\\s]+\\..+$"
    },
    "range": {
      "type": "object",
      "required": ["min", "max", "default"],
      "additionalProperties": false,
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"},
        "default": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "choices": {
      "description": "A name of a built-in list or the list itself.",
      "oneOf": [
        {"enum": ["comfy_samplers", "comfy_schedulers"]},
        {"type": "array", "items": {"type": "string"}, "minItems": 1}
      ]
    },
    "choice_setting": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": false,
      "properties": {
        "default": {"type": "string"},
        "choices": {"$ref": "#/$defs/choices"}
      }
    },
    "link": {
      "description": "A reference to an output of a node: [node id, output slot].",
      "type": "array",
      "prefixItems": [{"type": "string"}, {"type": "integer", "minimum": 0}],
      "items": false,
      "minItems": 2
    },
    "workflow": {
      "description": "A ComfyUI workflow exported with 'Save (API Format)'. Inputs the app fills in carry a placeholder.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["class_type", "inputs"],
        "properties": {
          "class_type": {"type": "string", "minLength": 1},
          "inputs": {"type": "object"},
          "_meta": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "manifest": {
      "type": "object",
      "required": ["model_name", "files", "bind", "images", "size", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "model_name": {"type": "string", "minLength": 1},
        "model_version": {"description": "The version shown after the name. MODEL_VERSION overrides it.", "type": "string", "minLength": 1},
        "vram_headroom_gb": {"description": "GPU memory in GB the generation needs on top of the weights. Used to decide whether ComfyUI keeps the weights on the GPU. Default 6.", "type": "number", "exclusiveMinimum": 0},
        "custom_nodes": {
          "description": "ComfyUI custom nodes to install into custom_nodes/<name> if that folder is missing: a git repository (or one folder of it) at an exact commit.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "git", "ref"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
              "git": {"type": "string", "pattern": "^https://"},
              "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "subdir": {"description": "Install only this folder of the repository.", "type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"}
            }
          }
        },
        "variants": {
          "description": "Alternatives chosen with --variant: each replaces keys of file entries (matched by their 'set' target) and optionally the model_version.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model_version": {"type": "string", "minLength": 1},
              "files": {
                "type": "object",
                "propertyNames": {"$ref": "#/$defs/target"},
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "url": {"type": "string", "pattern": "^https://"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                    "size": {"type": "integer", "minimum": 1},
                    "license": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "required_nodes": {"type": "array", "items": {"type": "string"}},
        "missing_nodes_hint": {"type": "string"},
        "licenses": {
          "description": "Licenses a file can refer to. Downloading a file with a license requires the user to accept it (ACCEPT_LICENSES=<id>).",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["name", "url"],
            "additionalProperties": false,
            "properties": {"name": {"type": "string"}, "url": {"type": "string"}}
          }
        },
        "files": {
          "description": "Weight files, as names relative to 'folder' (a folder below the ComfyUI root), written to 'set'. A file that is missing is downloaded from 'url'. 'env' optionally names an environment variable that overrides the file (its value is then used as it is, nothing is downloaded); without 'name' it is required.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["folder", "set"],
            "anyOf": [{"required": ["name", "url"]}, {"required": ["env"]}],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "url": {"type": "string", "pattern": "^https://"},
              "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "size": {"type": "integer", "minimum": 1},
              "license": {"type": "string"},
              "env": {"type": "string"},
              "folder": {"type": "string"},
              "set": {"$ref": "#/$defs/target"}
            }
          }
        },
        "bind": {
          "type": "object",
          "required": ["prompt", "seed", "steps", "sampler", "scheduler"],
          "additionalProperties": false,
          "properties": {
            "prompt": {"$ref": "#/$defs/target"},
            "negative_prompt": {"$ref": "#/$defs/target"},
            "seed": {"$ref": "#/$defs/target"},
            "steps": {"$ref": "#/$defs/target"},
            "cfg": {"$ref": "#/$defs/target"},
            "denoise": {"$ref": "#/$defs/target"},
            "sampler": {"$ref": "#/$defs/target"},
            "scheduler": {"$ref": "#/$defs/target"}
          }
        },
        "constants": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/target"}
        },
        "seed": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 1},
            "wrap": {"type": "boolean"}
          }
        },
        "images": {
          "type": "object",
          "required": ["source"],
          "additionalProperties": false,
          "properties": {
            "source": {"$ref": "#/$defs/target"},
            "references": {
              "type": "object",
              "required": ["target", "max"],
              "additionalProperties": false,
              "properties": {
                "target": {"type": "string", "pattern": "^[^.\\s]+\\..*\\{n\\}.*$"},
                "first_n": {"type": "integer", "minimum": 0},
                "max": {"type": "integer", "minimum": 1},
                "loader_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                "loader_id_start": {"type": "integer", "minimum": 0}
              },
              "oneOf": [{"required": ["loader_ids"]}, {"required": ["loader_id_start"]}]
            }
          }
        },
        "size": {
          "type": "object",
          "required": ["policy", "bind"],
          "properties": {
            "policy": {"enum": ["qwen21_tiers", "fixed_area"]},
            "bind": {"type": "object", "additionalProperties": {"$ref": "#/$defs/target"}}
          },
          "allOf": [
            {
              "if": {"properties": {"policy": {"const": "qwen21_tiers"}}},
              "then": {
                "properties": {"policy": true, "bind": {"required": ["resolution"], "propertyNames": {"const": "resolution"}}},
                "additionalProperties": false
              }
            },
            {
              "if": {"properties": {"policy": {"const": "fixed_area"}}},
              "then": {
                "required": ["megapixels"],
                "properties": {
                  "policy": true,
                  "bind": {"required": ["width", "height"], "propertyNames": {"enum": ["width", "height"]}},
                  "megapixels": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 1},
                  "default_megapixels": {"type": "number", "exclusiveMinimum": 0},
                  "multiple": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              }
            }
          ]
        },
        "loras": {
          "type": "object",
          "required": ["dir", "loader_class", "first_id", "from", "outputs", "feeds", "strength_inputs"],
          "additionalProperties": false,
          "properties": {
            "dir": {"type": "string"},
            "files": {
              "description": "LoRA files to download if missing: each goes to <dir>/<dir of the entry>/<name>; the subfolder is the LoRA's display name (a LoRA with several files shares one).",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["dir", "name", "url"],
                "additionalProperties": false,
                "properties": {
                  "dir": {"type": "string", "minLength": 1},
                  "name": {"type": "string", "minLength": 1},
                  "url": {"type": "string", "pattern": "^https://"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                  "size": {"type": "integer", "minimum": 1},
                  "license": {"type": "string"}
                }
              }
            },
            "loader_class": {"type": "string"},
            "first_id": {"type": "integer", "minimum": 0},
            "from": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/link"}},
            "outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "feeds": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/target"}, "minItems": 1}
            },
            "strength_inputs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
          }
        },
        "capabilities": {
          "type": "object",
          "required": ["supports_inpainting", "sampler", "scheduler", "steps"],
          "additionalProperties": false,
          "properties": {
            "supports_inpainting": {"type": "boolean"},
            "num_annotation_colors": {"type": "integer", "minimum": 0},
            "sampler": {"$ref": "#/$defs/choice_setting"},
            "scheduler": {"$ref": "#/$defs/choice_setting"},
            "steps": {"$ref": "#/$defs/range"},
            "cfg": {"$ref": "#/$defs/range"},
            "denoise": {"$ref": "#/$defs/range"},
            "lora_strength": {"$ref": "#/$defs/range"}
          }
        }
      },
      "dependentSchemas": {
        "loras": {"properties": {"capabilities": {"required": ["lora_strength"]}}}
      }
    }
  }
}
