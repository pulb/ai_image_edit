# SPDX-License-Identifier: GPL-3.0-or-later
# This file is GPL like the rest of this repo's own code; it only builds
# and runs it. The actual model weights it downloads at runtime
# (Qwen/Qwen-Image-2.1) and the ai-image-edit-qwen package it installs are
# licensed separately under Alibaba's Qwen RESEARCH LICENSE AGREEMENT
# (non-open-source, non-commercial; see
# https://huggingface.co/Qwen/Qwen-Image-2.1/blob/main/LICENSE). The
# resulting image combines both, so keep it private.
#
# Builds an image for the NiceGUI frontend + qwen_image backend only (the
# direct diffusers pipeline, no ComfyUI). Meant for RunPod (a GPU pod
# exposing port 7860) and Hugging Face (a Dockerfile-type Space, which
# also expects port 7860). Unlike the sibling Dockerfile (which deploys
# qwen_image_edit_comfy), this installs no ComfyUI, no gradio, and no
# aria2-fetched checkpoints/LoRAs — qwen_image loads its weights from the
# Hugging Face Hub at startup instead (see ai_image_edit_qwen's
# pipeline.load()), so nothing needs to be baked into the image beyond
# Python deps.
FROM python:3.11-slim

# git: needed for the `pip install git+https://...` installs below.
# libgl1/libglib2.0-0: defensive — some image-codec paths in
# torchvision/Pillow's optional backends expect them present.
RUN apt-get update && apt-get install -y git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Matches Hugging Face Spaces' expected non-root container user (uid 1000);
# harmless on RunPod, which doesn't require it.
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1
WORKDIR $HOME/app

# Pin explicitly — app.py's own defaults already match, but a deployment
# shouldn't depend on that staying true.
ENV MODEL_BACKEND=qwen_image
ENV FRONTEND=nicegui

# PyTorch (CUDA 12.6 wheels) — this base image has no CUDA/PyTorch
# preinstalled. --user installs into $HOME/.local since /usr/local is
# root-owned here. No torchaudio: nothing in this deployment uses audio.
RUN pip install --no-cache-dir --user torch==2.11.0 torchvision==0.26.0 \
    --index-url https://download.pytorch.org/whl/cu126

# The qwen_image backend's inference package (it brings the pinned
# diffusers commit, transformers, accelerate and `spaces`; override
# QWEN_LIB_REF with a branch, tag or commit to pin a version) plus nicegui
# for the frontend and the core's own numpy/pillow. No gradio: this image
# only ever runs FRONTEND=nicegui.
ARG QWEN_LIB_REF=main
RUN pip install --no-cache-dir --user \
    "ai-image-edit-qwen @ git+https://github.com/pulb/ai_image_edit_qwen@${QWEN_LIB_REF}" \
    pillow \
    numpy \
    nicegui

# Inject own files into the container. Only what qwen_image + nicegui
# actually need: frontends/gradio_ui.py and models/qwen_image_edit_comfy/
# are both omitted (their loaders in frontends/__init__.py and
# models/__init__.py are only ever reached via FRONTEND=gradio /
# MODEL_BACKEND=qwen_image_edit_comfy, neither of which this image sets).
COPY --chown=user app.py $HOME/app/app.py
COPY --chown=user core $HOME/app/core
COPY --chown=user frontends/__init__.py $HOME/app/frontends/__init__.py
COPY --chown=user frontends/nicegui.py $HOME/app/frontends/nicegui.py
COPY --chown=user models/__init__.py $HOME/app/models/__init__.py
COPY --chown=user models/base.py $HOME/app/models/base.py
COPY --chown=user models/qwen_image $HOME/app/models/qwen_image

# HF_TOKEN (for gated weights or a private AOTI repo) and QWEN21_AOTI /
# QWEN21_AOTI_REPO (see models/qwen_image/model.py's start()) are read
# from the environment at runtime, not baked in here — set them via
# RunPod's or the Space's own environment variable settings if needed.
#
# Weights aren't baked into this image (see the top-of-file note) — every
# fresh container re-downloads Qwen-Image-2.1 from the Hub on startup. On
# a RunPod pod that persists across restarts, point HF_HUB_CACHE at a
# mounted network volume (e.g. `-e HF_HUB_CACHE=/runpod-volume/hf-cache`,
# with that path mounted as the pod's volume) so the download only
# happens once, without baking multi-GB weights into the image itself.

EXPOSE 7860

CMD ["python", "app.py"]
