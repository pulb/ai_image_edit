# SPDX-License-Identifier: GPL-3.0-or-later
# This file is GPL like the rest of this repo's own code; it only builds
# and runs it. The actual model weights it downloads at runtime
# (Qwen/Qwen-Image-2.1) and the ai-image-edit-qwen package it installs are
# licensed separately under Alibaba's Qwen RESEARCH LICENSE AGREEMENT
# (non-open-source, non-commercial; see
# https://huggingface.co/Qwen/Qwen-Image-2.1/blob/main/LICENSE). The
# resulting image combines both, so keep it private.
#
# Builds an image for the NiceGUI frontend + qwen_image21 backend only (the
# direct diffusers pipeline, no ComfyUI). Meant for RunPod (a GPU pod
# exposing port 7860) and Hugging Face (a Dockerfile-type Space, which
# also expects port 7860). Unlike the sibling Dockerfile (which deploys
# qwen_image_edit_2511_aio), this installs no ComfyUI, no gradio, and no
# aria2-fetched checkpoints/LoRAs — qwen_image21 loads its weights from the
# Hugging Face Hub at startup instead (see ai_image_edit_qwen's
# pipeline.load()), so nothing needs to be baked into the image beyond
# Python deps.
FROM python:3.11-slim

# git: needed for the `pip install git+https://...` installs below.
# libgl1/libglib2.0-0: defensive — some image-codec paths in
# torchvision/Pillow's optional backends expect them present.
RUN apt-get update && apt-get install -y git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Matches Hugging Face Spaces' expected non-root container user (uid 1000);
# harmless on RunPod, which doesn't require it.
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1
WORKDIR $HOME/app

# Pin explicitly — app.py's own defaults already match, but a deployment
# shouldn't depend on that staying true.
ENV MODEL_BACKEND=qwen_image21
ENV FRONTEND=nicegui

# Images (uploads, results) live in RAM under /dev/shm, never on disk. This
# is the cap the app enforces by deleting the oldest files first. It cannot
# exceed 90% of the container's /dev/shm (docker run --shm-size; Docker's
# default is 64 MB), and the app warns at startup if it had to lower it.
ENV AI_IMAGE_EDIT_WORK_MAX_SIZE=512m

# This image is meant for public hosts (RunPod's HTTP proxy has no login of
# its own), so the app refuses to start unless APP_PASSWORD is set.
ENV REQUIRE_PASSWORD=1

# PyTorch (CUDA 12.6 wheels) — this base image has no CUDA/PyTorch
# preinstalled. --user installs into $HOME/.local since /usr/local is
# root-owned here. No torchaudio: nothing in this deployment uses audio.
ARG TORCH_VERSION=2.11.0
ARG TORCHVISION_VERSION=0.26.0
RUN pip install --no-cache-dir --user torch==${TORCH_VERSION} torchvision==${TORCHVISION_VERSION} \
    --index-url https://download.pytorch.org/whl/cu126

# Install the app as a package with the NiceGUI frontend, plus the qwen_image21
# backend's inference package ai-image-edit-qwen, installed separately so
# QWEN_LIB_REF can pin it to a branch, tag or commit. It brings the pinned
# diffusers commit, transformers, accelerate and `spaces`. No gradio: this
# image only ever runs FRONTEND=nicegui.
ARG QWEN_LIB_REF=main
COPY --chown=user pyproject.toml LICENSE $HOME/pkg/
COPY --chown=user src $HOME/pkg/src
RUN pip install --no-cache-dir --user \
    "ai-image-edit-qwen @ git+https://github.com/pulb/ai_image_edit_qwen@${QWEN_LIB_REF}" \
    "$HOME/pkg[nicegui_frontend]"

# Optional runtime variables (HF_TOKEN, QWEN21_AOTI, QWEN21_AOTI_REPO) are
# read from the environment, not baked in here; see
# deployments/docker/DEPLOY.md.
#
# Weights aren't baked into this image (see the top-of-file note) — every
# fresh container re-downloads Qwen-Image-2.1 from the Hub on startup. On
# a RunPod pod that persists across restarts, point HF_HUB_CACHE at a
# mounted network volume (e.g. `-e HF_HUB_CACHE=/workspace/hf-cache`,
# a folder on the volume, which a Pod mounts at /workspace) so the download only
# happens once, without baking multi-GB weights into the image itself.

EXPOSE 7860

CMD ["python", "-m", "ai_image_edit"]
